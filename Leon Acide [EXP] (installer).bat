:auditpol
echo.
echo   [D] Désactiver Auditpol, [A] Activer Auditpol, [R] Réstaurer Auditpol (original), [M] Menu, [Q] Quitter
set /P parfeu=• [D/A/R/M/Q] :
if /I "%parfeu%"=="D" goto auditpol_disable
if /I "%parfeu%"=="A" goto auditpol_enable
if /I "%parfeu%"=="R" goto auditpol_restaure
if /I "%parfeu%"=="M" goto LeonAcide
if /I "%parfeu%"=="Q" goto appexit
goto invalidchoice

:auditpol_disable
auditpol /backup /file:"C:\LeonAcide\Auditpol.log"
auditpol /clear /y
auditpol /remove /allusers
auditpol /set /category:* /Success:disable /failure:disable
auditpol /set /option:CrashOnAuditFail /value:disable
auditpol /set /option:AuditBaseObjects /value:disable
auditpol /set /option:AuditBasedirectories /value:disable
auditpol /set /option:FullprivilegeAuditing /value:disable
auditpol /get /option:CrashOnAuditFail
