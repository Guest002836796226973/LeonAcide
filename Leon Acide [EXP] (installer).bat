:parfeu
echo.
echo   [A] Activer les ajustements du parfeu, [E] Exporter les règles, [I] Importer les règles, [R] Réinitialiser le parfeu, [M] Menu, [Q] Quitter
set /P parfeu=• [A/E/R/M/Q] :
if /I "%parfeu%"=="A" goto FTP
if /I "%parfeu%"=="E" goto exportparfeu
if /I "%parfeu%"=="I" goto importparfeu
if /I "%parfeu%"=="R" goto reset_rule
if /I "%parfeu%"=="M" goto LeonAcide
if /I "%parfeu%"=="Q" goto appexit
goto invalidchoice

:exportparfeu
echo.
echo   Règles exportées
netsh advfirewall export "C:\LeonAcide\sauvegarde_du_parfeu.wfw"
goto parfeu

:importparfeu
echo.
echo   Règles importées
netsh advfirewall import "C:\LeonAcide\sauvegarde_du_parfeu.wfw"
goto parfeu

:FTP
echo.
echo   [B] Bloquer le services FTP, [A] Autoriser le service FTP, [I] Ignorer
set /P FTP=• [B/A/I] :
if /I "%FTP%"=="B" goto enableFTP
if /I "%FTP%"=="A" goto disableFTP
if /I "%FTP%"=="I" goto PPTP
goto invalidchoice

:enableFTP
echo.
echo   Application de la règle de blocage FTP
echo   Application de la règle de blocage FTP >> "%log%"
netsh advfirewall set global statefulftp disable
goto PPTP

:disableFTP
echo.
echo   Application de la règle d'autorisation FTP
echo   Application de la règle d'autorisation FTP >> "%log%"
netsh advfirewall set global statefulftp enable
goto PPTP

:PPTP
echo.
echo   [B] Bloquer le services PPTP, [A] Autoriser le service PPTP, [I] Ignorer
set /P PPTP=• [B/A/I] :
if /I "%PPTP%"=="B" goto disablePPTP
if /I "%PPTP%"=="A" goto enablePPTP
if /I "%PPTP%"=="I" goto multidiffusion
goto invalidchoice

:disablePPTP
echo.
echo   Application de la règle de blocage PPTP
echo   Application de la règle de blocage PPTP >> "%log%"
netsh advfirewall set global StatefulPPTP disable
goto multidiffusion

:enablePPTP
echo.
echo   Application de la règle d'autorisation PPTP
echo   Application de la règle d'autorisation PPTP >> "%log%"
netsh advfirewall set global StatefulPPTP enable
goto multidiffusion

:multidiffusion
echo.
echo   [D] Désactiver la gestion Multidiffusion, [A] Activer la gestion Multidiffusion, [I] Ignorer
set /P multidiffusion=• [D/A/I] :
if /I "%multidiffusion%"=="D" goto disableMultidiffusion
if /I "%multidiffusion%"=="A" goto enableMultidiffusion
if /I "%multidiffusion%"=="I" goto ajustementsParfeu
goto invalidchoice

:disableMultidiffusion
echo.
echo   Désactiver le service monodiffusion est contrôlé par la réponse multidiffusion
echo   Désactiver le service monodiffusion est contrôlé par la réponse multidiffusion >> "%log%"
netsh advfirewall set allprofiles settings unicastresponsetomulticast disable
goto ajustementsParfeu

:enableMultidiffusion
echo.
echo   Activer le service monodiffusion est contrôlé par la réponse multidiffusion
echo   Activer le service monodiffusion est contrôlé par la réponse multidiffusion >> "%log%"
netsh advfirewall set allprofiles settings unicastresponsetomulticast enable
goto ajustementsParfeu

:ajustementsParfeu
echo.
echo   [A] Ajustements divers (recommandé), [I] Ignorer
set /P ajustementsParfeu=• [A/I] :
if /I "%ajustementsParfeu%"=="A" goto ajustementsParfeu_
if /I "%ajustementsParfeu%"=="I" goto systeme
goto invalidchoice

:ajustementsParfeu_
echo.
echo   Configure l’état du pare-feu (activé)
echo   Configure l’état du pare-feu (activé) >> "%log%"
netsh.exe advfirewall set allprofiles state on
echo.
echo   Journalisation des connexions abandonnées (C:\LeonAcide\Journalisation_parfeu.log)
echo   Journalisation des connexions abandonnées (C:\LeonAcide\Journalisation_parfeu.log) >> "%log%"
netsh advfirewall set allprofiles logging allowedconnections disable
netsh advfirewall set allprofiles logging droppedconnections enable 
netsh advfirewall set allprofiles logging filename "C:\LeonAcide\Journalisation_parfeu.log"
netsh advfirewall set allprofiles logging maxfilesize 8192
echo.
echo   Gère les protocoles par défaut exemptés de la protection IPsec (aucun)
echo   Gère les protocoles par défaut exemptés de la protection IPsec (aucun) >> "%log%"
netsh advfirewall set global ipsec defaultexemptions none
echo.
echo   Echec de connexion sur toute les erreurs liées à la liste de révocation de certificats (toutes)
echo   Echec de connexion sur toute les erreurs liées à la liste de révocation de certificats (toutes) >> "%log%"
netsh advfirewall set global ipsec strongcrlcheck 2
echo.
echo   Durée d’inactivité en minutes pour une association de sécurité
echo   Durée d’inactivité en minutes pour une association de sécurité >> "%log%"
netsh advfirewall set global ipsec saidletimemin 5
