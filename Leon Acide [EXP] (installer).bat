:systeme
echo.
echo   [A] Ajouter les applications Windows, [I] Ignorer
set /P systeme=• [A/I] :
if /I "%systeme%"=="A" goto systemeWindows
if /I "%systeme%"=="I" goto systemeFiles
goto invalidchoice

:systemeWindows
@CD /d "%systemroot%"
for %%* in (.) do set RULENAME=%%~nx*
for /r %%G in ("*.exe") Do (@echo %%G
netsh advfirewall firewall add rule name="%RULENAME%-%%~nxG" dir=in program="%%G" action="block" enable="yes")
for /r %%G in ("*.exe") Do (@echo %%G
netsh advfirewall firewall add rule name="%RULENAME%-%%~nxG" dir=out program="%%G" action="block" enable="yes")
netsh advfirewall firewall delete rule name=all program="%systemroot%\system32\svchost.exe"
netsh advfirewall firewall add rule name="Réseau de base (DNS-Out)" dir=out action=allow protocol=UDP remoteport=53 program="%systemroot%\system32\svchost.exe" service="dnscache"
netsh advfirewall firewall add rule name="Réseau de base (DHCP-Out)" dir=out action=allow protocol=UDP localport=68 remoteport=67 program="%systemroot%\system32\svchost.exe" service="dhcp"
echo.
echo   ^< Appuyez sur n'importe quelle touche ^>
pause>nul
goto systemeFiles

