:reset_rule
echo.
for /f %%A in ('"prompt $H & for %%B in (1) do rem"') do set "BS=%%A"
<nul set /p ="•   Veuillez patienter %username%"
for %%A in (. . .) do (
    <nul set /p "=%%A"
    timeout /nobreak /t 1 >nul
    for /l %%i in (1,1,0) do <nul set /p "=%BS%"
)
echo.
netsh advfirewall reset
echo   Parfeu réinitialisé
echo.
echo   ^< Appuyez sur n'importe quelle touche ^>
