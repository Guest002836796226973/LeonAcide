auditpol /set /option:CrashOnAuditFail /value:enable
auditpol /set /option:AuditBaseObjects /value:enable
auditpol /set /option:AuditBasedirectories /value:enable
auditpol /set /option:FullprivilegeAuditing /value:enable
auditpol /get /option:CrashOnAuditFail
